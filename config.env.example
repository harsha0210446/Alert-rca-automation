# ── Datadog (choose ONE method) ──────────────────────────────────────────────

# Method 1: Personal Access Token ONLY (recommended — no API/App keys needed)
# Get from: Datadog → Personal Settings → Access Tokens → Create Token
# Must have scopes: monitors_read, timeseries_query, logs_read (for RCA)
DD_ACCESS_TOKEN=

# Method 2: Legacy API key + App key (optional, skip if using DD_ACCESS_TOKEN)
# DD_API_KEY=
# DD_APP_KEY=

DD_SITE=datadoghq.com

# ── Google Chat: posting RCA replies (incoming webhook, write-only) ──────────
GOOGLE_CHAT_WEBHOOK_URL=

# ── Google Chat: reading source alerts (OAuth, read-only) ────────────────────
# Space ID to read alerts FROM (find it in that space's webhook/settings URL,
# e.g. https://chat.googleapis.com/v1/spaces/AAQAyoHxvpU/... -> AAQAyoHxvpU)
GOOGLE_CHAT_SOURCE_SPACE_ID=
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials). Default: credentials/google_chat_oauth_client.json
GOOGLE_CHAT_OAUTH_CLIENT_JSON=credentials/google_chat_oauth_client.json

# Default Datadog monitor search query (only used if DD_ACCESS_TOKEN is set)
DD_MONITOR_QUERY=status:alert OR status:warn
