# ── Datadog (choose ONE method) ──────────────────────────────────────────────

# Method 1: Personal Access Token ONLY (recommended — no API/App keys needed)
# Get from: Datadog → Personal Settings → Access Tokens → Create Token
# Must have scopes: monitors_read, timeseries_query, logs_read (for RCA)
DD_ACCESS_TOKEN=

# Method 2: Legacy API key + App key (optional, skip if using DD_ACCESS_TOKEN)
# DD_API_KEY=
# DD_APP_KEY=

DD_SITE=datadoghq.com

# ── Google Chat (for posting RCA replies) ────────────────────────────────────
GOOGLE_CHAT_WEBHOOK_URL=

# ── Webhook server (optional — auto-create alerts from incoming webhooks) ────
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# Default Datadog monitor search query (only used if DD_ACCESS_TOKEN is set)
DD_MONITOR_QUERY=status:alert OR status:warn

# Comma-separated local paths to search for the failing source file when a
# stack trace is found in logs (e.g. "at com.pharmeasy...(FileName.kt:123)").
# Leave blank to skip codebase lookup.
CODEBASE_SEARCH_PATHS=

# ── Automation (required for auto RCA → Google Chat) ─────────────────────────
AUTO_RCA_ENABLED=true
AUTO_PUBLISH_ENABLED=true

# LLM for automated RCA — set ONE of these (required):
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
